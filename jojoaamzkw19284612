            local att1 = Instance.new("Attachment", tracePart)
            local beam = Instance.new("Beam")
            beam.Color = ColorSequence.new(settingsConfig.ESPColor)
            beam.Width0 = 0.12
            beam.Width1 = 0.12
            beam.Transparency = NumberSequence.new(0.1)
            beam.FaceCamera = true
            beam.Attachment0 = att0
            beam.Attachment1 = att1
            beam.Enabled = states.ESP and isValidTarget(p)
            beam.Parent = tracePart
            espCache[p] = {Highlight = hl, Billboard = bg, InfoLabel = infoLabel, TracePart = tracePart, Beam = beam, Att0 = att0, Att1 = att1}
        end
        p.CharacterAdded:Connect(apply)
        if p.Character then apply(p.Character) end
    end
    local function removeESP(p)
        if espCache[p] then
            pcall(function()
                if espCache[p].Highlight then espCache[p].Highlight:Destroy() end
                if espCache[p].Billboard then espCache[p].Billboard:Destroy() end
                if espCache[p].TracePart then espCache[p].TracePart:Destroy() end
            end)
            espCache[p] = nil
        end
    end
    for _, p in ipairs(Players:GetPlayers()) do setupESP(p) end
    Players.PlayerAdded:Connect(setupESP)
    Players.PlayerRemoving:Connect(removeESP)

    local espUpdateTimer = 0
    RunService.Heartbeat:Connect(function(dt)
        espUpdateTimer = espUpdateTimer + dt
        if espUpdateTimer < 0.08 then return end
        espUpdateTimer = 0
        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        for p, data in pairs(espCache) do
            if data and data.Highlight and data.Beam then
                local valid = states.ESP and isValidTarget(p)
                data.Highlight.Enabled = valid
                data.Beam.Enabled = valid
                data.Billboard.Enabled = valid
                if valid and myRoot and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") then
                    local targetRoot = p.Character.HumanoidRootPart
                    local hum = p.Character.Humanoid
                    data.TracePart.Position = targetRoot.Position
                    data.Att0.WorldPosition = myRoot.Position - Vector3.new(0,2,0)
                    data.Att1.WorldPosition = targetRoot.Position
                    local dist = math.floor((myRoot.Position - targetRoot.Position).Magnitude)
                    local hp = math.floor(hum.Health)
                    data.InfoLabel.Text = dist .. " studs | HP: " .. hp
                end
            end
        end
    end)
end

-- ======== 실행 ========
if loadKeyData() and os.time() < keyExpiryTime then
    CreateMainUI()
else
    createKeyUI()
end
