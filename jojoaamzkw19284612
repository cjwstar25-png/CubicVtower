local autoClickHeld = false
local autoclickTask = nil

local function getEquippedTool()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChildOfClass("Tool")
end

local function doOneClick()
    if VirtualUser then
        local ok = pcall(function()
            VirtualUser:CaptureController()
            VirtualUser:Button1Down(Vector2.new(0,0), getCamera().CFrame)
            task.wait(0.01)
            VirtualUser:Button1Up(Vector2.new(0,0), getCamera().CFrame)
        end)
        if ok then return end
    end
    local tool = getEquippedTool()
    if tool then
        local ok = pcall(function() tool:Activate() end)
        if ok then return end
    end
    if AttackRemote then
        pcall(function() AttackRemote:FireServer() end)
    end
end

local function stopAutoClick()
    autoClickHeld = false
    if autoclickTask then pcall(task.cancel, autoclickTask); autoclickTask = nil end
end

local function startAutoClick()
    if autoClickHeld then return end
    autoClickHeld = true
    autoclickTask = task.spawn(function()
        while autoClickHeld and states.AutoClick do
            doOneClick()
            local cps = math.max(1, settingsConfig.AutoClickCPS or 20)
            task.wait(1 / cps)
        end
        autoClickHeld = false
        autoclickTask = nil
    end)
end

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if not states.AutoClick then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1
       or input.UserInputType == Enum.UserInputType.Touch then
        startAutoClick()
    end
end)
