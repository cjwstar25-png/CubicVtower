-- ESP
local espCache = {}
local function setupESP(p)
    if p == LocalPlayer then return end

    local function apply(char)
        if not char then return end
        if espCache[p] then
            pcall(function()
                if espCache[p].Highlight then espCache[p].Highlight:Destroy() end
                if espCache[p].Billboard then espCache[p].Billboard:Destroy() end
                if espCache[p].TracePart then espCache[p].TracePart:Destroy() end
            end)
        end

        local hl = Instance.new("Highlight")
        hl.Name = "CubicESP"
        hl.Adornee = char
        hl.FillColor = settingsConfig.ESPColor
        hl.OutlineColor = Color3.fromRGB(255,255,255)
        hl.FillTransparency = 0.4
        hl.OutlineTransparency = 0
        hl.Enabled = states.ESP and isValidTarget(p) and not states.Invisibility
        hl.Parent = char

        local bg = Instance.new("BillboardGui")
        bg.Name = "CubicESPInfo"
        bg.Size = UDim2.new(0,150,0,50)
        bg.StudsOffset = Vector3.new(0,3,0)
        bg.AlwaysOnTop = true
        bg.Enabled = states.ESP and isValidTarget(p) and not states.Invisibility
        bg.Parent = char:WaitForChild("Head",5) or char

        local nameLabel = Instance.new("TextLabel")
        nameLabel.Size = UDim2.new(1,0,0,20)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.Text = p.Name
        nameLabel.TextColor3 = Color3.fromRGB(255,255,255)
        nameLabel.TextSize = 12
        nameLabel.TextStrokeTransparency = 0.5
        nameLabel.Parent = bg

        local infoLabel = Instance.new("TextLabel")
        infoLabel.Size = UDim2.new(1,0,0,20)
        infoLabel.Position = UDim2.new(0,0,0,18)
        infoLabel.BackgroundTransparency = 1
        infoLabel.Font = Enum.Font.Gotham
        infoLabel.Text = "[Health: 100]"
        infoLabel.TextColor3 = Color3.fromRGB(200,200,200)
        infoLabel.TextSize = 10
        infoLabel.TextStrokeTransparency = 0.5
        infoLabel.Parent = bg

        local tracePart = Instance.new("Part")
        tracePart.Size = Vector3.new(0.1,0.1,0.1)
        tracePart.Transparency = 1
        tracePart.CanCollide = false
        tracePart.Anchored = true
        tracePart.Parent = Workspace

        local att0 = Instance.new("Attachment", Workspace.Terrain)
        local att1 = Instance.new("Attachment", tracePart)

        local beam = Instance.new("Beam")
        beam.Color = ColorSequence.new(settingsConfig.ESPColor)
        beam.Width0 = 0.12
        beam.Width1 = 0.12
        beam.Transparency = NumberSequence.new(0.1)
        beam.FaceCamera = true
        beam.Attachment0 = att0
        beam.Attachment1 = att1
        beam.Enabled = states.ESP and isValidTarget(p) and not states.Invisibility
        beam.Parent = tracePart

        espCache[p] = {
            Highlight = hl,
            Billboard = bg,
            InfoLabel = infoLabel,
            TracePart = tracePart,
            Beam = beam,
            Att0 = att0,
            Att1 = att1
        }
    end

    p.CharacterAdded:Connect(apply)
    if p.Character then apply(p.Character) end
end

local function removeESP(p)
    if espCache[p] then
        pcall(function()
            if espCache[p].Highlight then espCache[p].Highlight:Destroy() end
            if espCache[p].Billboard then espCache[p].Billboard:Destroy() end
            if espCache[p].TracePart then espCache[p].TracePart:Destroy() end
        end)
        espCache[p] = nil
    end
end

for _, p in ipairs(Players:GetPlayers()) do setupESP(p) end
