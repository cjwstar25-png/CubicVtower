    sub.Parent = toast

    local body = Instance.new("TextLabel")
    body.Size = UDim2.new(1, -14 * uiScale, 0, 16 * uiScale)
    body.Position = UDim2.new(0, 12 * uiScale, 0, 18 * uiScale)
