local function refreshConfigList()
    for _, child in pairs(FileListContainer:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    if not ensureFolder() then return end
    local success, files = pcall(function() return listfiles("CubicConfigs") end)
    if success and files then
        local count = 0
        for _, filePath in ipairs(files) do
            if filePath:sub(-5) == ".json" then
                count = count + 1
                local fileName = filePath:match("([^/]+)$"):gsub("%.json$", "")
                local fileBtn = Instance.new("TextButton")
                fileBtn.Size = UDim2.new(1, -10 * uiScale, 0, 30 * uiScale)
                fileBtn.Position = UDim2.new(0, 5 * uiScale, 0, 0)
                fileBtn.BackgroundColor3 = Color3.fromRGB(25, 30, 42)
                fileBtn.Font = Enum.Font.Gotham
                fileBtn.Text = "📁  " .. fileName
                fileBtn.TextColor3 = Color3.fromRGB(220, 230, 250)
                fileBtn.TextSize = 11 * uiScale
                fileBtn.TextXAlignment = Enum.TextXAlignment.Left
                fileBtn.Parent = FileListContainer
