local function copyToClipboard(text)
    pcall(function()
        if syn and syn.write_clipboard then syn.write_clipboard(text)
        elseif setclipboard then setclipboard(text)
        elseif toclipboard then toclipboard(text)
        else
            local toast = Instance.new("TextLabel")
            toast.Size = UDim2.new(0, 300, 0, 40)
            toast.Position = UDim2.new(0.5, -150, 0.9, 0)
            toast.BackgroundColor3 = Color3.fromRGB(20, 24, 33)
            toast.Font = Enum.Font.GothamBold
            toast.Text = "Key: " .. text
            toast.TextColor3 = Color3.fromRGB(255, 255, 255)
            toast.TextSize = 14
            toast.Parent = CoreGui
            task.delay(3, function() toast:Destroy() end)
        end
    end)
end

