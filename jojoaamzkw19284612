-- ============================================================
-- SAVE / LOAD
-- ============================================================
local SAVE_PATH = "CubicScriptState.json"
local saveDirty = false
local function saveState() saveDirty = true end

task.spawn(function()
    while true do
        task.wait(2)
        if saveDirty then
            saveDirty = false
            local data = { States = states, Settings = settingsConfig, Skin = currentSkin }
            pcall(function() writefile(SAVE_PATH, HttpService:JSONEncode(data)) end)
        end
    end
end)

local function loadState()
    local raw
    pcall(function() if isfile(SAVE_PATH) then raw = readfile(SAVE_PATH) end end)
    if not raw then return end
    pcall(function()
        local data = HttpService:JSONDecode(raw)
        if data.States then
            for k, v in pairs(data.States) do
                if states[k] ~= nil then states[k] = v end
            end
        end
        if data.Settings then
            for k, v in pairs(data.Settings) do
                if settingsConfig[k] ~= nil then settingsConfig[k] = v end
            end
        end
        if data.Skin then currentSkin = data.Skin end
    end)
end

