    pcall(function()
        local mt = getrawmetatable(game)
        if HAS_SETRO then setreadonly(mt, false) end
        local oldNamecall = mt.__namecall
        mt.__namecall = noClosureWrap(function(self, ...)
            local method = getnamecallmethod()
            if method == "FireServer" and states.SilentAim then
                local char = LocalPlayer.Character
                if char then
                    local target, dist = getClosestTarget()
                    if target and dist < (settingsConfig.KillAuraRange or 100) then
                        local head = target.Character and target.Character:FindFirstChild("Head")
                        if head then
                            local args = {...}
                            local replaced = false
                            for i, v in ipairs(args) do
                                if typeof(v) == "Vector3" then
                                    args[i] = head.Position
                                    replaced = true
                                end
                            end
                            if replaced then
                                registerHit(target)
                                return oldNamecall(self, table.unpack(args))
                            end
                        end
                    end
                end
            end
            return oldNamecall(self, ...)
        end)
        if HAS_SETRO then setreadonly(mt, true) end
    end)
end

local triggerCooldown = 0
RunService.RenderStepped:Connect(function(dt)
    if not states.AdvancedSilentAim then return end
    local char = LocalPlayer.Character
    if not char then return end
    local target = getClosestTarget()
    if not target then return end
    local head = target.Character:FindFirstChild("Head")
    if not head then return end
    local cam = getCamera()
    local screenPos, onScreen = cam:WorldToScreenPoint(head.Position)
    if not onScreen then return end
    local vps = cam.ViewportSize
    local center = Vector2.new(vps.X/2, vps.Y/2)
    local angle = (screenPos - center).Magnitude / math.min(vps.X, vps.Y) * (cam.FieldOfView/2) * 2.2
    if angle > settingsConfig.AimFOV then return end
    if not states.Wallbang then
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {char, target.Character}
        local dir = (head.Position - cam.CFrame.Position).Unit * 500
        local result = Workspace:Raycast(cam.CFrame.Position, dir, params)
        if result then return end
    end
    cam.CFrame = CFrame.new(cam.CFrame.Position, head.Position)
    registerHit(target)
    if states.TriggerBot then
        triggerCooldown = triggerCooldown - dt
        if triggerCooldown <= 0 then
            doOneClick()
            triggerCooldown = settingsConfig.TriggerDelay
        end
    end
end)

