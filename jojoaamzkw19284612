    phaseGodActive = true
    task.delay(0.1, function()
        for _, part in ipairs(phaseGodParts) do
            if part and part.Parent then
                part.CFrame = part.CFrame - Vector3.new(0,500,0)
            end
        end
        phaseGodParts = {}
        phaseGodActive = false
    end)
end

