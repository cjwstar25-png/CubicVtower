    Grid.CellSize = UDim2.new(0.46, 0, 0, 75 * uiScale)
    Grid.CellPadding = UDim2.new(0, 12 * uiScale, 0, 12 * uiScale)
    Grid.Parent = Content

    tabContents[name] = Content

    TabBtn.MouseButton1Click:Connect(function()
        for _, c in pairs(tabContents) do c.Visible = false end
        for _, b in pairs(TabContainer:GetChildren()) do
            if b:IsA("TextButton") then
                TweenService:Create(b, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {BackgroundColor3 = Color3.fromRGB(25, 30, 42)}):Play()
