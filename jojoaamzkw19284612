-- 고급 Silent Aim
local triggerCooldown = 0
RunService.RenderStepped:Connect(function(dt)
    if not states.AdvancedSilentAim then return end
    local char = LocalPlayer.Character
    if not char then return end
    local target, dist = getClosestTarget()
    if not target then return end
    local head = target.Character:FindFirstChild("Head")
    if not head then return end
    local screenPos, onScreen = Camera:WorldToScreenPoint(head.Position)
    if not onScreen then return end
    local viewportSize = Camera.ViewportSize
    local center = Vector2.new(viewportSize.X/2, viewportSize.Y/2)
    local distance = (screenPos - center).Magnitude
    local maxDist = math.min(viewportSize.X, viewportSize.Y) / 2
    local fovRatio = distance / maxDist
    local angle = fovRatio * (Camera.FieldOfView / 2) * 1.1
    if angle > settingsConfig.AimFOV then return end
    if not states.Wallbang then
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = {char, target.Character}
        local direction = (head.Position - Camera.CFrame.Position).Unit * 500
        local result = Workspace:Raycast(Camera.CFrame.Position, direction, rayParams)
        if result and result.Instance then return end
    end
    Camera.CFrame = CFrame.new(Camera.CFrame.Position, head.Position)
    if states.TriggerBot then
        triggerCooldown = triggerCooldown - dt
        if triggerCooldown <= 0 then
            pcall(function()
                VirtualUser:Button1Down(Vector2.new(0,0), nil)
                task.wait(0.02)
                VirtualUser:Button1Up(Vector2.new(0,0), nil)
            end)
            triggerCooldown = settingsConfig.TriggerDelay
        end
    end
end)

