local function logNotify(text, color)
    local n = Instance.new("Frame")
    n.Size = UDim2.new(0, 240 * uiScale, 0, 34 * uiScale)
    n.Position = UDim2.new(1, -250 * uiScale, 0, 60 * uiScale + #toastStack * 46 * uiScale)
    n.BackgroundColor3 = THEME.bg_panel
    n.BorderSizePixel = 0
    n.Parent = ScreenGui
    decorate(n, 8, THEME.stroke_soft, 0.4)
    local ac = Instance.new("Frame")
    ac.Size = UDim2.new(0, 3 * uiScale, 1, -12 * uiScale)
    ac.Position = UDim2.new(0, 0, 0, 6 * uiScale)
    ac.BackgroundColor3 = color
    ac.BorderSizePixel = 0
    ac.Parent = n
    decorate(ac, 2)
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, -14 * uiScale, 1, 0)
    l.Position = UDim2.new(0, 12 * uiScale, 0, 0)
    l.BackgroundTransparency = 1
    l.Font = Enum.Font.Gotham
    l.Text = text
    l.TextColor3 = THEME.text
    l.TextSize = 11 * uiScale
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Parent = n
    table.insert(toastStack, n)
    task.delay(4, function()
        if n.Parent then n:Destroy() end
        for i, t in ipairs(toastStack) do if t == n then table.remove(toastStack, i); break end end
    end)
end

local function setupLog(player)
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    if not hum then return end
    local last = hum.Health
    hum.HealthChanged:Connect(function(new)
        if not states.Log then last = new; return end
        if new < last and new > 0 then
            local dmg = math.floor(last - new)
            logNotify(string.format("%s -%d HP", player.Name, dmg), Color3.fromRGB(255,180,60))
        elseif new <= 0 and last > 0 then
            logNotify(string.format("%s died", player.Name), THEME.danger)
        end
        last = new
    end)
end
Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function() task.wait(0.5); setupLog(p) end)
end)
for _, p in ipairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then
        p.CharacterAdded:Connect(function() task.wait(0.5); setupLog(p) end)
        if p.Character then setupLog(p) end
    end
end

