    local entry = tabContents[currentTab]
    if not entry or not entry.content then return end
    for _, child in ipairs(entry.content:GetChildren()) do
        if child:IsA("Frame") and child:GetAttribute("ToggleKey") then
            local key = child:GetAttribute("SearchKey") or ""
            child.Visible = (query == "") or (key:find(query, 1, true) ~= nil)
        end
    end
    if entry.update then entry.update() end
end

SearchInput:GetPropertyChangedSignal("Text"):Connect(applySearch)
SearchInput.Focused:Connect(function()
    TweenService:Create(SearchBar, TweenInfo.new(0.2), {
        Size = UDim2.new(0, 300*uiScale, 0, 34*uiScale),
        Position = UDim2.new(0.5, -150*uiScale, 0, TITLE_H*uiScale + 8*uiScale)
    }):Play()
end)

SearchBtn.MouseButton1Click:Connect(function()
    searchOpen = not searchOpen
    SearchBar.Visible = searchOpen
    if searchOpen then
        pcall(function() SearchInput:CaptureFocus() end)
    else
        SearchInput.Text = ""
    end
    TweenService:Create(SearchBtn, TweenInfo.new(0.2), {
        BackgroundColor3 = searchOpen and THEME.accent_dim or THEME.bg_input,
        TextColor3 = searchOpen and THEME.accent or THEME.text_dim
    }):Play()
end)

-- ============================================================
-- COMPACT MODE  (uses cardDescLabels table, not attributes)
-- ============================================================
local compact = false
CompactBtn.MouseButton1Click:Connect(function()
    compact = not compact
    local cellH = compact and 52 or 78
    for _, data in pairs(tabContents) do
        if data.grid then
            data.grid.CellSize = UDim2.new(0.48, 0, 0, cellH*uiScale)
        end
        if data.content then
            for _, child in ipairs(data.content:GetChildren()) do
                if child:IsA("Frame") and child:GetAttribute("ToggleKey") then
                    child.Size = UDim2.new(1, 0, 0, cellH*uiScale)
                    local desc = cardDescLabels[child]
                    if desc and desc.Parent then
                        desc.Visible = not compact
                    end
                end
            end
        end
        if data.update then data.update() end
    end
    TweenService:Create(CompactBtn, TweenInfo.new(0.2), {
        BackgroundColor3 = compact and THEME.accent_dim or THEME.bg_input,
        TextColor3 = compact and THEME.accent or THEME.text_dim
    }):Play()
end)

