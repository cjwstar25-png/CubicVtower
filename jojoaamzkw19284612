RunService.Heartbeat:Connect(function()
    pcall(function()
        if not states.BadFly or not badFlyActive then return end
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChild("Humanoid")
        if not root or not hum then return end
        hum.PlatformStand = true
        local cam = getCamera()
        local camCF = cam.CFrame
        local forward = camCF.LookVector * Vector3.new(1,0,1)
        local right   = camCF.RightVector * Vector3.new(1,0,1)
        if forward.Magnitude > 0 then forward = forward.Unit end
        if right.Magnitude > 0 then right = right.Unit end
        local move = Vector3.new()
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + forward end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move - forward end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - right end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + right end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            badFlyY = (badFlyY or root.Position.Y) + 1
        elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
            badFlyY = (badFlyY or root.Position.Y) - 1
        end
        if badFlyY == nil then badFlyY = root.Position.Y end
        local speed = settingsConfig.BadFlySpeed or 16
        if move.Magnitude > 0 then move = move.Unit * speed end
        root.AssemblyLinearVelocity = Vector3.new(move.X, 0, move.Z)
        root.CFrame = CFrame.new(root.Position.X, badFlyY, root.Position.Z)
    end)
end)

