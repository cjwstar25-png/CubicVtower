local logNotifications = {}

local function showLogNotification(text, color)
    if #logNotifications >= 4 then
        local old = table.remove(logNotifications, 1)
        if old and old.Parent then old:Destroy() end
    end
    local notif = Instance.new("Frame")
    notif.Size = UDim2.new(0, 300, 0, 50)
    notif.Position = UDim2.new(1, -320, 0, 10 + #logNotifications*56)
    notif.BackgroundColor3 = THEME.bg_panel
    notif.BorderSizePixel = 0
    notif.Parent = ScreenGui
    Instance.new("UICorner", notif).CornerRadius = UDim.new(0, 10)
    local stroke = Instance.new("UIStroke", notif)
    stroke.Color = color
    stroke.Thickness = 2
    stroke.Transparency = 0.3

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -20, 1, 0)
    label.Position = UDim2.new(0, 14, 0, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBold
    label.Text = text
    label.TextColor3 = THEME.text
    label.TextSize = 12
    label.TextWrapped = true
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = notif

    table.insert(logNotifications, notif)
    task.delay(6, function()
        if notif.Parent then notif:Destroy() end
        for i, n in ipairs(logNotifications) do
            if n == notif then table.remove(logNotifications, i); break end
        end
    end)
end

local function setupLog(player)
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    if not hum then return end
    local last = hum.Health
    hum.HealthChanged:Connect(function(new)
        if not states.Log then last = new; return end
        if new < last and new > 0 then
            local dmg = math.floor(last - new)
            local color
            if dmg < 10 then color = Color3.fromRGB(255,255,100)
            elseif dmg < 30 then color = Color3.fromRGB(255,200,50)
            else color = Color3.fromRGB(255,100,50) end
            showLogNotification(string.format("%s took %d damage", player.Name, dmg), color)
        elseif new <= 0 and last > 0 then
            showLogNotification(string.format("%s died", player.Name), Color3.fromRGB(255,50,50))
        end
        last = new
    end)
end

Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function() task.wait(0.5); setupLog(p) end)
end)
for _, p in ipairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then
        p.CharacterAdded:Connect(function() task.wait(0.5); setupLog(p) end)
        if p.Character then setupLog(p) end
    end
end

