local espCache = {}
local function createESP(p)
    if p == LocalPlayer then return end
    local tracer = Drawing.new("Line")
    tracer.Visible = false; tracer.Color = settingsConfig.ESPColor; tracer.Thickness = 1.5
    local box = Drawing.new("Square")
    box.Visible = false; box.Color = settingsConfig.ESPColor; box.Thickness = 1; box.Filled = false
    espCache[p] = {Tracer = tracer, Box = box}
end
local function removeESP(p)
    if espCache[p] then
        if espCache[p].Tracer then espCache[p].Tracer:Remove() end
        if espCache[p].Box then espCache[p].Box:Remove() end
        espCache[p] = nil
    end
end
for _, p in ipairs(Players:GetPlayers()) do createESP(p) end
Players.PlayerAdded:Connect(createESP)
Players.PlayerRemoving:Connect(removeESP)

