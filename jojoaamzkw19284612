-- ============================================================
-- DRAG
-- ============================================================
local dragData = { active = false, start = nil, pos = nil }

local function beginDrag(input)
    dragData.active = true
    dragData.start = input.Position
    dragData.pos = Root.Position
end

local function updateDrag(input)
    if not dragData.active then return end
    local delta = input.Position - dragData.start
    local newX = dragData.pos.X.Offset + delta.X
    local newY = dragData.pos.Y.Offset + delta.Y
    local maxX = VIEW_W * 0.5 - 40 * uiScale
    local minX = -maxX
    local maxY = VIEW_H * 0.5 - 40 * uiScale
    local minY = -maxY
    newX = math.clamp(newX, minX, maxX)
    newY = math.clamp(newY, minY, maxY)
    Root.Position = UDim2.new(0.5, newX, 0.5, newY)
end

local function endDrag() dragData.active = false end

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
       or input.UserInputType == Enum.UserInputType.Touch then
        updateDrag(input)
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
       or input.UserInputType == Enum.UserInputType.Touch then
        endDrag()
    end
end)

