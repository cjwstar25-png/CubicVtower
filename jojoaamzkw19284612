-- [완벽 복구 가능한 Xray 시스템] (최적화: 변경 필요 시에만 투명도 조절)
local xrayCache = {}
RunService.RenderStepped:Connect(function()
    if states.Xray then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") and obj ~= Workspace.Terrain then
                local isPlayerPart = false
                for _, p in ipairs(Players:GetPlayers()) do
                    if p.Character and obj:IsDescendantOf(p.Character) then
                        isPlayerPart = true
                        break
                    end
                end
                if not isPlayerPart then
                    if not xrayCache[obj] then
                        xrayCache[obj] = obj.Transparency
                    end
                    if obj.Transparency < 0.65 then
                        obj.Transparency = 0.65
                    end
                end
            end
        end
    else
        if next(xrayCache) then
            for obj, origTrans in pairs(xrayCache) do
                if obj and obj.Parent then
                    obj.Transparency = origTrans
                end
            end
            xrayCache = {}
        end
    end
end)

-- [프리미엄 ESP 박스 + 명확한 트레이서트 선 및 인포 시스템]
local espCache = {}

local function setupESP(p)
    if p == LocalPlayer then return end
    
    local function apply(char)
        if not char then return end
        if espCache[p] then 
            pcall(function() 
                if espCache[p].Highlight then espCache[p].Highlight:Destroy() end
                if espCache[p].Billboard then espCache[p].Billboard:Destroy() end
                if espCache[p].TracePart then espCache[p].TracePart:Destroy() end
            end)
        end
        
        -- HighLight
        local hl = Instance.new("Highlight")
        hl.Name = "CubicESP"
        hl.Adornee = char
        hl.FillColor = settingsConfig.ESPColor
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.FillTransparency = 0.4
        hl.OutlineTransparency = 0
        hl.Enabled = states.ESP
        hl.Parent = char
        
        -- 정보 표시 BillboardGui (이름, 거리, 체력)
        local bg = Instance.new("BillboardGui")
        bg.Name = "CubicESPInfo"
        bg.Size = UDim2.new(0, 150, 0, 50)
        bg.StudsOffset = Vector3.new(0, 3, 0)
        bg.AlwaysOnTop = true
        bg.Enabled = states.ESP
        bg.Parent = char:WaitForChild("Head", 5) or char
        
        local nameLabel = Instance.new("TextLabel")
        nameLabel.Size = UDim2.new(1, 0, 0, 20)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.Text = p.Name
        nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        nameLabel.TextSize = 12
        nameLabel.TextStrokeTransparency = 0.5
        nameLabel.Parent = bg
        
        local infoLabel = Instance.new("TextLabel")
        infoLabel.Size = UDim2.new(1, 0, 0, 20)
        infoLabel.Position = UDim2.new(0, 0, 0, 18)
        infoLabel.BackgroundTransparency = 1
        infoLabel.Font = Enum.Font.Gotham
        infoLabel.Text = "[Health: 100]"
        infoLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
        infoLabel.TextSize = 10
        infoLabel.TextStrokeTransparency = 0.5
        infoLabel.Parent = bg

        -- 명확한 트레이서트 선을 위한 빔 구성
        local tracePart = Instance.new("Part")
        tracePart.Size = Vector3.new(0.1, 0.1, 0.1)
        tracePart.Transparency = 1
        tracePart.CanCollide = false
        tracePart.Anchored = true
        tracePart.Parent = Workspace
        
        local att0 = Instance.new("Attachment", Workspace.Terrain)
        local att1 = Instance.new("Attachment", tracePart)
        
        local beam = Instance.new("Beam")
        beam.Color = ColorSequence.new(settingsConfig.ESPColor)
        beam.Width0 = 0.12
        beam.Width1 = 0.12
        beam.Transparency = NumberSequence.new(0.1)
        beam.FaceCamera = true
        beam.Attachment0 = att0
        beam.Attachment1 = att1
        beam.Enabled = states.ESP
        beam.Parent = tracePart

        espCache[p] = {Highlight = hl, Billboard = bg, InfoLabel = infoLabel, TracePart = tracePart, Beam = beam, Att0 = att0, Att1 = att1}
    end
    
    p.CharacterAdded:Connect(apply)
    if p.Character then apply(p.Character) end
end

local function removeESP(p)
    if espCache[p] then
        pcall(function() 
            if espCache[p].Highlight then espCache[p].Highlight:Destroy() end
            if espCache[p].Billboard then espCache[p].Billboard:Destroy() end
            if espCache[p].TracePart then espCache[p].TracePart:Destroy() end
        end)
        espCache[p] = nil
    end
end

for _, p in ipairs(Players:GetPlayers()) do setupESP(p) end
Players.PlayerAdded:Connect(setupESP)
Players.PlayerRemoving:Connect(removeESP)

RunService.RenderStepped:Connect(function()
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    
    for p, data in pairs(espCache) do
        if data and data.Highlight and data.Beam then
            data.Highlight.Enabled = states.ESP
            data.Highlight.FillColor = settingsConfig.ESPColor
            data.Beam.Enabled = states.ESP
            data.Beam.Color = ColorSequence.new(settingsConfig.ESPColor)
            data.Billboard.Enabled = states.ESP
            
            if states.ESP and myRoot and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") then
                local targetRoot = p.Character.HumanoidRootPart
                local hum = p.Character.Humanoid
                
                data.TracePart.Position = targetRoot.Position
                data.Att0.WorldPosition = myRoot.Position - Vector3.new(0, 2, 0)
                data.Att1.WorldPosition = targetRoot.Position
                
                local dist = math.floor((myRoot.Position - targetRoot.Position).Magnitude)
                local hp = math.floor(hum.Health)
                data.InfoLabel.Text = dist .. " studs | HP: " .. hp
            end
        end
    end
end)
