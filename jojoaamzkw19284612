local function createTabButton(name, layoutOrder)
    local TabBtn = Instance.new("TextButton")
    TabBtn.Size = UDim2.new(0, 70, 1, 0)
    TabBtn.BackgroundColor3 = layoutOrder == 1 and Color3.fromRGB(0, 140, 255) or Color3.fromRGB(25, 30, 42)
    TabBtn.Font = Enum.Font.GothamBold
    TabBtn.Text = name
    TabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    TabBtn.TextSize = 11
    TabBtn.LayoutOrder = layoutOrder
    TabBtn.Parent = TabContainer

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 6)
    Corner.Parent = TabBtn

    local Content = Instance.new("ScrollingFrame")
    Content.Name = name .. "Content"
    Content.Size = UDim2.new(1, -20, 1, -70)
    Content.Position = UDim2.new(0, 10, 0, 60)
    Content.BackgroundTransparency = 1
    Content.BorderSizePixel = 0
    Content.CanvasSize = UDim2.new(0, 0, 0, 1000)
    Content.ScrollBarThickness = 4
    Content.ScrollBarImageColor3 = Color3.fromRGB(0, 162, 255)
    Content.Visible = (layoutOrder == 1)
    Content.Parent = MainFrame

    local Grid = Instance.new("UIGridLayout")
    Grid.CellSize = UDim2.new(0, 285, 0, 75)
    Grid.CellPadding = UDim2.new(0, 16, 0, 16)
    Grid.Parent = Content

    tabContents[name] = Content

    TabBtn.MouseButton1Click:Connect(function()
        for _, c in pairs(tabContents) do c.Visible = false end
        for _, b in pairs(TabContainer:GetChildren()) do
            if b:IsA("TextButton") then
                TweenService:Create(b, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {BackgroundColor3 = Color3.fromRGB(25, 30, 42)}):Play()
            end
        end
        Content.Visible = true
        TweenService:Create(TabBtn, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {BackgroundColor3 = Color3.fromRGB(0, 140, 255)}):Play()
    end)
    return Content
end

