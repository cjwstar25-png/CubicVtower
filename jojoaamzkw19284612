-- 에임봇 및 월체크
RunService.RenderStepped:Connect(function()
    if states.Aimbot then
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local myPos = char.HumanoidRootPart.Position
            local closestDist = math.huge
            local targetHead = nil
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                    local head = p.Character.Head
                    if states.WallCheck then
                        local rayParams = RaycastParams.new()
                        rayParams.FilterType = Enum.RaycastFilterType.Exclude
                        rayParams.FilterDescendantsInstances = {char, p.Character}
                        if Workspace:Raycast(myPos, head.Position - myPos, rayParams) then continue end
                    end
                    local dist = (myPos - head.Position).Magnitude
                    if dist < closestDist then
                        closestDist = dist
                        targetHead = head
                    end
                end
            end
            if targetHead then Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHead.Position) end
        end
    end
end)

