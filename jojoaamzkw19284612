    overlay.Name = "GanziOverlay"
    overlay.ResetOnSpawn = false
    overlay.IgnoreGuiInset = true
    pcall(function() overlay.Parent = CoreGui end)
    if overlay.Parent ~= CoreGui then
        overlay.Parent = LocalPlayer:WaitForChild("PlayerGui")
    end
    table.insert(ganziObjects, overlay)

    local overlayFrame = Instance.new("Frame")
    overlayFrame.Size = UDim2.new(1, 0, 1, 0)
    overlayFrame.BackgroundTransparency = 0.6
    overlayFrame.BackgroundColor3 = Color3.fromRGB(0,0,0)
    overlayFrame.Parent = overlay
    table.insert(ganziObjects, overlayFrame)

    local grad = Instance.new("UIGradient")
    grad.Rotation = 45
    grad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255,0,0)),
        ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255,255,0)),
        ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0,255,0)),
        ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0,255,255)),
        ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0,0,255)),
        ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255,0,255)),
        ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255,0,0))
    })
    grad.Parent = overlayFrame
end

