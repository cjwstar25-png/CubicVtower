    btn.TextSize = 10*uiScale
    btn.LayoutOrder = order
    btn.AutoButtonColor = false
    btn.Parent = TabContainer

    local underline = Instance.new("Frame")
    underline.Size = UDim2.new(1, -10*uiScale, 0, 2*uiScale)
    underline.Position = UDim2.new(0, 5*uiScale, 1, -4*uiScale)
    underline.BackgroundColor3 = THEME.accent
    underline.BackgroundTransparency = (order == 1) and 0 or 1
    underline.BorderSizePixel = 0
    underline.Parent = btn
    Instance.new("UICorner", underline).CornerRadius = UDim.new(1, 0)

    tabButtons[name] = { btn = btn, underline = underline }

    local content = Instance.new("ScrollingFrame")
    content.Name = name .. "Content"
    content.Size = UDim2.new(1, -20*uiScale, 1, -(TITLE_H + 18)*uiScale)
    content.Position = UDim2.new(0, 10*uiScale, 0, (TITLE_H + 10)*uiScale)
    content.BackgroundTransparency = 1
    content.BorderSizePixel = 0
    content.CanvasSize = UDim2.new(0, 0, 0, 0)
    content.ScrollBarThickness = 4
    content.ScrollBarImageColor3 = THEME.accent
    content.ScrollBarImageTransparency = 0.5
    content.Visible = (order == 1)
    content.Parent = MainFrame

    local grid = Instance.new("UIGridLayout", content)
    grid.CellSize = UDim2.new(0.48, 0, 0, 78*uiScale)
    grid.CellPadding = UDim2.new(0, 10*uiScale, 0, 10*uiScale)
    grid.SortOrder = Enum.SortOrder.LayoutOrder

    local function updateCanvas()
        local visible = 0
        for _, c in ipairs(content:GetChildren()) do
            if c:IsA("Frame") and c.Visible then
                visible = visible + 1
            end
        end
        local rows = math.max(1, math.ceil(visible / 2))
        content.CanvasSize = UDim2.new(0, 0, 0, rows*(78*uiScale + 10*uiScale) + 24*uiScale)
    end
    content.ChildAdded:Connect(updateCanvas)
    content.ChildRemoved:Connect(updateCanvas)

    tabContents[name] = { content = content, grid = grid, update = updateCanvas }

    btn.MouseButton1Click:Connect(function()
        currentTab = name
        for nm, data in pairs(tabContents) do
            data.content.Visible = (nm == name)
            if tabButtons[nm] and tabButtons[nm].underline then
                TweenService:Create(tabButtons[nm].underline, TweenInfo.new(0.2), {
                    BackgroundTransparency = (nm == name) and 0 or 1
                }):Play()
            end
            if tabButtons[nm] and tabButtons[nm].btn then
                TweenService:Create(tabButtons[nm].btn, TweenInfo.new(0.2), {
                    TextColor3 = (nm == name) and THEME.accent or THEME.text_dim
                }):Play()
            end
        end
        updateCanvas()
    end)
    return content
end

