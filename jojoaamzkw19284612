applySkin = function(skinName)
    local preset = SKIN_PRESETS[skinName]
    if not preset then return end
    local char = LocalPlayer.Character
    if not char then return end
    if skinName == "Rainbow" then
        task.spawn(function()
            local hue = 0
            while states.SkinChanger and skinName == currentSkin do
                hue = (hue + 0.01) % 1
                local color = Color3.fromHSV(hue, 1, 1)
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                        part.BrickColor = BrickColor.new(color)
                    end
                end
                task.wait(0.05)
            end
        end)
        return
    end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            if preset.Color then part.BrickColor = BrickColor.new(preset.Color) end
            if preset.Texture and (part.Name == "Torso" or part.Name == "UpperTorso") then
                local tex = Instance.new("Texture")
                tex.Texture = preset.Texture
                tex.Face = Enum.NormalId.Front
                tex.Parent = part
            end
        end
    end
end

resetSkin = function()
    local char = LocalPlayer.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then part.BrickColor = BrickColor.new("White") end
        if part:IsA("Texture") then part:Destroy() end
    end
end

