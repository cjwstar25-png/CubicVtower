-- ============================================================
-- HOOK PROBE + MINIMAL BYPASS
-- ============================================================
local HAS_HOOKFN = type(hookfunction)      == "function"
local HAS_HOOKMM = type(hookmetamethod)    == "function"
local HAS_RAWMT  = type(getrawmetatable)   == "function"
local HAS_SETRO  = type(setreadonly)       == "function"
local HAS_NEWC   = type(newcclosure)       == "function"
local HAS_GETNC  = type(getnamecallmethod) == "function"

local function noClosureWrap(f)
    if HAS_NEWC then return newcclosure(f) end
    return f
end

if HAS_HOOKMM and HAS_RAWMT and HAS_GETNC then
    pcall(function()
        local mt = getrawmetatable(game)
        if HAS_SETRO then setreadonly(mt, false) end
        local oldNamecall = mt.__namecall
        mt.__namecall = noClosureWrap(function(self, ...)
            local method = getnamecallmethod()
            if method == "Kick" or method == "Ban" then return nil end
            if method == "Teleport" or method == "TeleportToPlaceInstance"
               or method == "TeleportAsync" or method == "TeleportToPrivateServer"
               or method == "TeleportPartyAsync" then return nil end
            return oldNamecall(self, ...)
        end)
        if HAS_SETRO then setreadonly(mt, true) end
    end)
end
if HAS_HOOKFN then
    pcall(function()
        if type(LocalPlayer.Kick) == "function" then
            hookfunction(LocalPlayer.Kick, function() return nil end)
        end
    end)
end

-- ============================================================
-- TELEPORT PERSISTENCE
-- Saves own source to CubicScript.lua and queues re-exec on teleport.
-- Works on executors that expose queue_on_teleport / readfile / writefile.
-- ============================================================
local SCRIPT_FILE = "CubicScript.lua"

local function getSelfSource()
    local ok, info = pcall(debug.getinfo, 1, "s")
    if ok and info and info.source then
        local src = info.source
        if type(src) == "string" and src:sub(1,1) == "@" then
            local ok2, content = pcall(readfile, src:sub(2))
            if ok2 and content then return content end
        end
    end
    return nil
end

local function setupTeleportPersistence()
    local canFile = false
    pcall(function() canFile = (readfile and writefile and isfile) and true or false end)
    if canFile then
        local exists = false
        pcall(function() exists = isfile(SCRIPT_FILE) end)
        if not exists then
            local src = getSelfSource()
            if src and #src > 0 then
                pcall(function() writefile(SCRIPT_FILE, src) end)
            end
        end
    end

    local queueFn
    pcall(function() queueFn = queue_on_teleport end)
    if not queueFn then
        pcall(function() queueFn = queueonteleport end)
    end
    if not queueFn then return false end

    local reloader = table.concat({
        'local ok, src = pcall(readfile, "', SCRIPT_FILE, '")',
        'if ok and src and #src > 0 then',
        '    local fn = loadstring(src)',
        '    if fn then pcall(fn) end',
        'end'
    }, "\n")

    pcall(function() queueFn(reloader) end)
    return true
end

local teleportPersistOK = setupTeleportPersistence()

