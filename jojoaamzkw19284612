-- [Key 저장 변수]
local keyAuthorized = false
local keyExpiryTime = 0
local currentKey = ""
local SAVED_KEY_PATH = "CubicKeyData.json"

local function loadKeyData()
    pcall(function()
        if isfile(SAVED_KEY_PATH) then
            local raw = readfile(SAVED_KEY_PATH)
            local data = HttpService:JSONDecode(raw)
            if data and data.key and data.expiry then
                if os.time() < data.expiry then
                    currentKey = data.key
                    keyExpiryTime = data.expiry
                    keyAuthorized = true
                    return true
                end
            end
        end
    end)
    return false
end

local function saveKeyData(key, expiry)
    pcall(function()
        local data = { key = key, expiry = expiry }
        writefile(SAVED_KEY_PATH, HttpService:JSONEncode(data))
    end)
end

