                showLogNotification(string.format("%s took %d damage", player.Name, dmg), Color3.fromRGB(255, 200, 100), "💥")
            elseif newHealth <= 0 and lastHealth > 0 then
                showLogNotification(string.format("%s died", player.Name), Color3.fromRGB(255, 100, 100), "☠️")
            end
            lastHealth = newHealth
        end)
