updateToggleUI = function(stateKey)
    local elem = toggleElements[stateKey]
    if not elem or not elem.btn or not elem.circle or not elem.stroke or not elem.accent then
        return
    end
    local on = states[stateKey]
    TweenService:Create(elem.btn, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
        BackgroundColor3 = on and THEME.accent or THEME.stroke_idle
    }):Play()
    TweenService:Create(elem.circle, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
        Position = on and UDim2.new(1, -18*uiScale, 0.5, -8*uiScale)
                     or UDim2.new(0,   3*uiScale, 0.5, -8*uiScale)
    }):Play()
    TweenService:Create(elem.stroke, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
        Color = on and THEME.accent or THEME.stroke_idle,
        Transparency = on and 0.3 or 0
    }):Play()
    TweenService:Create(elem.accent, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
        BackgroundTransparency = on and 0 or 1
    }):Play()
end

updateAllToggles = function()
    for k in pairs(toggleElements) do updateToggleUI(k) end
end

