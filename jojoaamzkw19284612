local function setupLog(player)
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    if not hum then return end
    local lastHealth = hum.Health
    hum.HealthChanged:Connect(function(newHealth)
        if not states.Log then return end
        if newHealth < lastHealth and newHealth > 0 then
            local dmg = math.floor(lastHealth - newHealth)
            local color
            if dmg < 10 then color = Color3.fromRGB(255,255,100)
            elseif dmg < 30 then color = Color3.fromRGB(255,200,50)
            else color = Color3.fromRGB(255,100,50) end
            showLogNotification(string.format("%s took %d damage", player.Name, dmg), color, "💥")
        elseif newHealth <= 0 and lastHealth > 0 then
            showLogNotification(string.format("%s died", player.Name), Color3.fromRGB(255,50,50), "☠️")
        end
        lastHealth = newHealth
    end)
end

