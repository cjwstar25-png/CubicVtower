    TweenService:Create(elem.btn, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {
        BackgroundColor3 = on and THEME.btn_active or THEME.btn_idle
    }):Play()
    if elem.stroke then
        TweenService:Create(elem.stroke, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {
            Color = on and THEME.accent or THEME.stroke_soft,
            Transparency = on and 0.35 or 0.7
        }):Play()
    end
    if elem.plus then
        TweenService:Create(elem.plus, TweenInfo.new(0.18), {
            TextColor3 = on and Color3.fromRGB(255,255,255) or THEME.text_faint,
