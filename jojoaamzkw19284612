-- ======== 자동 저장/복원 ========
local SAVE_PATH = "CubicLastState.json"

local function saveState()
    local data = {
        States = states,
        Settings = settingsConfig,
        Skin = currentSkin
    }
    pcall(function()
        writefile(SAVE_PATH, HttpService:JSONEncode(data))
    end)
end

local function loadState()
    local success, raw = pcall(function()
        if isfile(SAVE_PATH) then
            return readfile(SAVE_PATH)
        end
        return nil
    end)
    if raw then
        pcall(function()
            local data = HttpService:JSONDecode(raw)
            if data.States then
                for k, v in pairs(data.States) do
                    if states[k] ~= nil then
                        states[k] = v
                    end
                end
            end
            if data.Settings then
                for k, v in pairs(data.Settings) do
                    if settingsConfig[k] ~= nil then
                        settingsConfig[k] = v
                    end
                end
            end
            if data.Skin then
                currentSkin = data.Skin
            end
        end)
    end
end

