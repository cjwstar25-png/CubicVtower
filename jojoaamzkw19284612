local activeToasts = {}
showToast = function(text, color)
    if #activeToasts >= 3 then
        local old = table.remove(activeToasts, 1)
        if old and old.Parent then old:Destroy() end
    end
    local toast = Instance.new("Frame")
    toast.Size = UDim2.new(0, 180*uiScale, 0, 30*uiScale)
    toast.Position = UDim2.new(0.5, -90*uiScale, 0, -40*uiScale)
    toast.BackgroundColor3 = THEME.bg_panel
    toast.BorderSizePixel = 0
    toast.Parent = MainFrame
    Instance.new("UICorner", toast).CornerRadius = UDim.new(1, 0)
    Instance.new("UIStroke", toast).Color = color or THEME.accent

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -12*uiScale, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.GothamBold
    lbl.Text = text
    lbl.TextColor3 = THEME.text
    lbl.TextSize = 11*uiScale
    lbl.Parent = toast

    table.insert(activeToasts, toast)
    TweenService:Create(toast, TweenInfo.new(0.25), {
        Position = UDim2.new(0.5, -90*uiScale, 0, 8*uiScale)
    }):Play()
    task.delay(1.4, function()
        if toast.Parent then
            TweenService:Create(toast, TweenInfo.new(0.25), {
                Position = UDim2.new(0.5, -90*uiScale, 0, -40*uiScale)
            }):Play()
            task.wait(0.3)
            if toast.Parent then toast:Destroy() end
        end
        for i, t in ipairs(activeToasts) do
            if t == toast then table.remove(activeToasts, i); break end
        end
    end)
end

