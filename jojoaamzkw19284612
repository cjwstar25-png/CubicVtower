    body.TextColor3 = THEME.text
    body.TextSize = 11 * uiScale
    body.TextXAlignment = Enum.TextXAlignment.Left
    body.Parent = toast

    table.insert(toastStack, toast)

    TweenService:Create(toast, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Position = UDim2.new(1, -230 * uiScale, 0, 60 * uiScale + (#toastStack - 1) * 46 * uiScale)
    }):Play()

    task.delay(2.4, function()
        if toast.Parent then
            TweenService:Create(toast, TweenInfo.new(0.24), {
                Position = UDim2.new(1, 260 * uiScale, 0, toast.Position.Y.Offset)
            }):Play()
            task.wait(0.3)
            if toast.Parent then toast:Destroy() end
        end
        for i, t in ipairs(toastStack) do
            if t == toast then table.remove(toastStack, i); break end
        end
        for i, t in ipairs(toastStack) do
            if t and t.Parent then
                TweenService:Create(t, TweenInfo.new(0.2), {
                    Position = UDim2.new(1, -230 * uiScale, 0, 60 * uiScale + (i - 1) * 46 * uiScale)
                }):Play()
            end
        end
    end)
end

