-- ============================================================
-- SLIDER FACTORY
-- ============================================================
createSlider = function(parent, label, min, max, defaultVal, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -10*uiScale, 0, 54*uiScale)
    row.BackgroundTransparency = 1
    row.Parent = parent

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0.55, 0, 0, 18*uiScale)
    lbl.Position = UDim2.new(0, 4*uiScale, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.Gotham
    lbl.Text = label
    lbl.TextColor3 = THEME.text_dim
    lbl.TextSize = 11*uiScale
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = row

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0, 60*uiScale, 0, 22*uiScale)
    box.Position = UDim2.new(1, -62*uiScale, 0, 0)
    box.BackgroundColor3 = THEME.bg_input
    box.Font = Enum.Font.GothamBold
    box.Text = tostring(defaultVal)
    box.TextColor3 = THEME.accent
    box.TextSize = 11*uiScale
    box.ClearTextOnFocus = false
    box.Parent = row
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 4)
    Instance.new("UIStroke", box).Color = THEME.stroke_idle

    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, -8*uiScale, 0, 8*uiScale)
    track.Position = UDim2.new(0, 4*uiScale, 0, 32*uiScale)
    track.BackgroundColor3 = THEME.bg_input
    track.BorderSizePixel = 0
    track.Parent = row
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)
    Instance.new("UIStroke", track).Color = THEME.stroke_idle

    local range = math.max(0.0001, max - min)
    local initRatio = math.clamp((defaultVal - min) / range, 0, 1)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(initRatio, 0, 1, 0)
    fill.BackgroundColor3 = THEME.accent
    fill.BorderSizePixel = 0
    fill.Parent = track
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local handle = Instance.new("TextButton")
    handle.Size = UDim2.new(0, 18*uiScale, 0, 18*uiScale)
    handle.AnchorPoint = Vector2.new(0.5, 0.5)
    handle.Position = UDim2.new(initRatio, 0, 0.5, 0)
    handle.BackgroundColor3 = THEME.text
    handle.Text = ""
    handle.AutoButtonColor = false
    handle.Parent = track
    Instance.new("UICorner", handle).CornerRadius = UDim.new(1, 0)
    Instance.new("UIStroke", handle).Color = THEME.accent
    local handleInner = Instance.new("Frame")
    handleInner.Size = UDim2.new(0, 6*uiScale, 0, 6*uiScale)
    handleInner.AnchorPoint = Vector2.new(0.5, 0.5)
    handleInner.Position = UDim2.new(0.5, 0, 0.5, 0)
    handleInner.BackgroundColor3 = THEME.accent
    handleInner.BorderSizePixel = 0
    handleInner.Parent = handle
    Instance.new("UICorner", handleInner).CornerRadius = UDim.new(1, 0)

    local currentVal = defaultVal

    local function setVal(v, doCallback)
        v = math.clamp(v, min, max)
        currentVal = v
        local ratio = (v - min) / range
        fill.Size       = UDim2.new(ratio, 0, 1, 0)
        handle.Position = UDim2.new(ratio, 0, 0.5, 0)
        local str = string.format("%.2f", v)
        str = str:gsub("(%..-)0+$", "%1"):gsub("%.$", "")
        box.Text = str
        if doCallback then callback(v) end
    end

    local dragging = false
    local function ratioFromX(absX)
        local trackAbsX = track.AbsolutePosition.X
        local trackAbsW = track.AbsoluteSize.X
        if trackAbsW <= 0 then return 0 end
        return math.clamp((absX - trackAbsX) / trackAbsW, 0, 1)
    end

    local function beginDrag(input)
        dragging = true
        local ratio = ratioFromX(input.Position.X)
        setVal(min + ratio * range, false)
    end

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            beginDrag(input)
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    setVal(currentVal, true)
                    saveState()
                end
            end)
        end
    end)

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            beginDrag(input)
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    setVal(currentVal, true)
                    saveState()
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
           or input.UserInputType == Enum.UserInputType.Touch then
            local ratio = ratioFromX(input.Position.X)
            setVal(min + ratio * range, false)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
            setVal(currentVal, true)
            saveState()
        end
    end)

    box.FocusLost:Connect(function()
        local num = tonumber(box.Text)
        if num then
            setVal(num, true)
            saveState()
        else
            setVal(currentVal, false)
        end
    end)

    setVal(defaultVal, false)
    return row
end

