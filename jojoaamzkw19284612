-- REMOTE DISCOVERY
-- ============================================================
local AttackRemote = nil
local allEvents    = {}

local blacklist = {
    "integrity","analytics","localization","sender","service",
    "key","check","processor","location","telemetry",
    "log","report","ping","latency","heartbeat",
    "auth","session","validation","verify","token",
    "queue","manager","module","state","config",
    "setting","data","store","cache"
}
local whitelist = {
    "attack","hit","damage","swing","sword",
    "melee","click","fire","shoot","slash",
    "block","tool","combat","use","activate"
}

pcall(function()
    for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
        if v:IsA("RemoteEvent") then
            table.insert(allEvents, v)
        end
    end
    local bestEvent, bestScore = nil, -1
    for _, ev in ipairs(allEvents) do
        local name     = ev.Name:lower()
        local fullName = ev:GetFullName():lower()
        local score, black = 0, false
        for _, w in ipairs(blacklist) do
            if name:find(w) or fullName:find(w) then black = true; break end
        end
        if not black then
            for _, w in ipairs(whitelist) do
                if name:find(w) or fullName:find(w) then score = score + 10 end
            end
            if #name < 10 then score = score + 3 end
            if ev.Parent == ReplicatedStorage then score = score + 5 end
            if score > bestScore then bestScore = score; bestEvent = ev end
        end
    end
    AttackRemote = bestEvent or allEvents[1]
end)

local function Attack(target)
    if not AttackRemote then return end
    pcall(function()
        if target then AttackRemote:FireServer(target)
        else AttackRemote:FireServer() end
    end)
end

