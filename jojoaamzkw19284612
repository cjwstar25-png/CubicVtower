local badKillCooldown = 0
local cameraTarget = nil
local camTween = nil
RunService.RenderStepped:Connect(function(dt)
    pcall(function()
        if not states.BadKillAura then
            if camTween then camTween:Cancel() end
            return
        end
        badKillCooldown = badKillCooldown - dt
        if badKillCooldown <= 0 then
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if root then
                local target, targetChar, targetPlr
                local closestDist = math.huge
                local rangeBonus = states.HitboxExpander and settingsConfig.HitboxSize or 0
                local effectiveRange = settingsConfig.BadKillRange + rangeBonus
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer then
                        local skip = states.BadKillAuraTeamCheck
                                     and LocalPlayer.Team
                                     and plr.Team == LocalPlayer.Team
                        if not skip then
                            local eChar = plr.Character
                            local eRoot = eChar and eChar:FindFirstChild("HumanoidRootPart")
                            local eHum  = eChar and eChar:FindFirstChild("Humanoid")
                            if eRoot and eHum and eHum.Health > 0 then
                                local d = (root.Position - eRoot.Position).Magnitude
                                if d < effectiveRange and d < closestDist then
                                    local dot = root.CFrame.LookVector:Dot((eRoot.Position - root.Position).Unit)
                                    if dot > -0.5 then
                                        closestDist = d
                                        target = eRoot
                                        targetChar = eChar
                                        targetPlr = plr
                                    end
                                end
                            end
                        end
                    end
                end
                if target and targetChar then
                    Attack(targetChar)
                    if targetPlr then registerHit(targetPlr) end
                    cameraTarget = target
                else
                    cameraTarget = nil
                end
                badKillCooldown = settingsConfig.BadSwingDelay
            end
        end
        if states.BadKillAuraCamera and cameraTarget then
            local cam = getCamera()
            local goal = CFrame.new(cam.CFrame.Position, cameraTarget.Position)
            if camTween then camTween:Cancel() end
            camTween = TweenService:Create(cam,
                TweenInfo.new(settingsConfig.BadCameraSmoothness or 0.3,
                              Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                { CFrame = goal })
            camTween:Play()
        end
    end)
end)

