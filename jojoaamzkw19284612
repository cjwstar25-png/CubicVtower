createSliderRow = function(parent, label, min, max, defaultVal, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -6 * uiScale, 0, 44 * uiScale)
    row.BackgroundColor3 = THEME.btn_idle
    row.BorderSizePixel = 0
    row.Parent = parent
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 5)
    local rStroke = Instance.new("UIStroke", row)
    rStroke.Color = THEME.stroke_soft
    rStroke.Thickness = 1
    rStroke.Transparency = 0.75

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -60 * uiScale, 0, 16 * uiScale)
    lbl.Position = UDim2.new(0, 12 * uiScale, 0, 5 * uiScale)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.Gotham
    lbl.Text = label
    lbl.TextColor3 = THEME.text
    lbl.TextSize = 10 * uiScale
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextTruncate = Enum.TextTruncate.AtEnd
    lbl.Parent = row

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0, 48 * uiScale, 0, 16 * uiScale)
    box.Position = UDim2.new(1, -54 * uiScale, 0, 5 * uiScale)
    box.BackgroundTransparency = 1
    box.Font = Enum.Font.GothamBold
    box.Text = tostring(defaultVal)
    box.TextColor3 = THEME.accent_soft
    box.TextSize = 10 * uiScale
    box.TextXAlignment = Enum.TextXAlignment.Right
    box.ClearTextOnFocus = false
    box.Parent = row

    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, -24 * uiScale, 0, 5 * uiScale)
    track.Position = UDim2.new(0, 12 * uiScale, 1, -15 * uiScale)
    track.BackgroundColor3 = THEME.track_bg
    track.BorderSizePixel = 0
    track.Parent = row
    decorate(track, 3)

    local range = math.max(0.0001, max - min)
    local initRatio = math.clamp((defaultVal - min) / range, 0, 1)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(initRatio, 0, 1, 0)
    fill.BackgroundColor3 = THEME.accent
    fill.BorderSizePixel = 0
    fill.Parent = track
    decorate(fill, 3)
    local fGrad = Instance.new("UIGradient")
    fGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, THEME.accent),
        ColorSequenceKeypoint.new(1, THEME.accent_soft)
    })
    fGrad.Parent = fill

    local handle = Instance.new("TextButton")
    handle.Size = UDim2.new(0, 12 * uiScale, 0, 12 * uiScale)
    handle.AnchorPoint = Vector2.new(0.5, 0.5)
    handle.Position = UDim2.new(initRatio, 0, 0.5, 0)
    handle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    handle.BorderSizePixel = 0
    handle.Text = ""
    handle.AutoButtonColor = false
    handle.Parent = track
    decorate(handle, 6)
    local hStroke = handle:FindFirstChildOfClass("UIStroke")
    if hStroke then hStroke.Color = THEME.accent end

    local currentVal = defaultVal

    local function setVal(v, doCallback)
        v = math.clamp(v, min, max)
        currentVal = v
        local ratio = (v - min) / range
        fill.Size       = UDim2.new(ratio, 0, 1, 0)
        handle.Position = UDim2.new(ratio, 0, 0.5, 0)
        local str = string.format("%.2f", v)
        str = str:gsub("(%..-)0+$", "%1"):gsub("%.$", "")
        box.Text = str
        if doCallback then callback(v) end
    end

    local dragging = false
    local function ratioFromX(absX)
        local tx = track.AbsolutePosition.X
        local tw = track.AbsoluteSize.X
        if tw <= 0 then return 0 end
        return math.clamp((absX - tx) / tw, 0, 1)
    end

    local function beginDrag(input)
        dragging = true
        setVal(min + ratioFromX(input.Position.X) * range, false)
        TweenService:Create(handle, TweenInfo.new(0.12), {
            Size = UDim2.new(0, 14 * uiScale, 0, 14 * uiScale)
        }):Play()
    end

    local function finishDrag()
        dragging = false
        setVal(currentVal, true)
        saveState()
        TweenService:Create(handle, TweenInfo.new(0.12), {
            Size = UDim2.new(0, 12 * uiScale, 0, 12 * uiScale)
        }):Play()
    end

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            beginDrag(input)
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then finishDrag() end
            end)
        end
    end)
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            beginDrag(input)
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then finishDrag() end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
           or input.UserInputType == Enum.UserInputType.Touch then
            setVal(min + ratioFromX(input.Position.X) * range, false)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            finishDrag()
        end
    end)

    box.FocusLost:Connect(function()
        local num = tonumber(box.Text)
        if num then setVal(num, true); saveState()
        else setVal(currentVal, false) end
    end)

    setVal(defaultVal, false)
    return row
end

