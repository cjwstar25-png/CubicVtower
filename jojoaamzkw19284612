autoNoFallActive = false
local lockedFlightY = 0
task.spawn(function()
    while true do
        task.wait(0.05)
        if states.FlyNoFall and not states.Fly then
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
                local root = char.HumanoidRootPart
                local rayParams = RaycastParams.new()
                rayParams.FilterType = Enum.RaycastFilterType.Exclude
                rayParams.FilterDescendantsInstances = {char}
                local rayResult = Workspace:Raycast(root.Position, Vector3.new(0, -6, 0), rayParams)
                if root.AssemblyLinearVelocity.Y < -25 and not rayResult and not autoNoFallActive then
                    autoNoFallActive = true
                    lockedFlightY = root.Position.Y
                elseif rayResult and autoNoFallActive then
                    autoNoFallActive = false
                end
            end
        else
            autoNoFallActive = false
